{
  "name": "swim-language",
  "displayName": "swim",
  "description": "Syntax highlighting for swim, a Swift-syntax language that compiles to Nim.",
  "version": "0.1.0",
  "publisher": "swim-lang",
  "license": "MIT",
  "homepage": "https://github.com/steveriemannx/Swim",
  "repository": {
    "type": "git",
    "url": "https://github.com/steveriemannx/Swim.git",
    "directory": "editors/vscode/swim"
  },
  "bugs": {
    "url": "https://github.com/steveriemannx/Swim/issues"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "swim",
        "aliases": [
          "swim",
          "sw"
        ],
        "extensions": [
          ".sw"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "swim",
        "scopeName": "source.swim",
        "path": "./syntaxes/swim.tmLanguage.json"
      }
    ]
  },
  "files": [
    "language-configuration.json",
    "syntaxes/**",
    "README.md",
    "LICENSE.txt"
  ]
}
